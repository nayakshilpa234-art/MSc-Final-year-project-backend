{
  "installCommand": "cd /vercel/path0 && npm install --prefix backend && npm install --prefix frontend",
  "buildCommand": "cd /vercel/path0/frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**",
      "maxDuration": 30
    }
  }
}
